{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=MedicalAppointment;Username=postgres;Password=1234"
  },
  "Jwt": {
    "Issuer": "myapp",
    "Audience": "myapp-api",
    "SecretKey": "__REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARS__",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Swagger": {
    "Enabled": false
  },
  "Observability": {
    "OtlpEnabled": false,
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Resilience": {
    "Dependencies": {
      "PaymentService": {
        "TimeoutMilliseconds": 3000,
        "Retry": {
          "MaxAttempts": 2,
          "DelayMilliseconds": 200,
          "MaxDelayMilliseconds": 2000,
          "UseJitter": true
        },
        "CircuitBreaker": {
          "FailureRatio": 0.5,
          "MinimumThroughput": 10,
          "SamplingDurationMilliseconds": 30000,
          "BreakDurationMilliseconds": 15000
        }
      },
      "NotificationService": {
        "TimeoutMilliseconds": 5000,
        "Retry": {
          "MaxAttempts": 3,
          "DelayMilliseconds": 300,
          "MaxDelayMilliseconds": 3000,
          "UseJitter": true
        }
      }
    }
  },
  "Bulkhead": {
    "Payment": {
      "PermitLimit": 5,
      "QueueLimit": 10
    },
    "Notification": {
      "PermitLimit": 10,
      "QueueLimit": 20
    }
  }
}